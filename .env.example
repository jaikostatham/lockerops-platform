SPRING_PROFILES_ACTIVE=local

DB_HOST=localhost
DB_PORT=5432
DB_NAME=lockerops_test
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# Used by the standalone Flyway migration task.
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=

DB_MAX_POOL_SIZE=5

SERVER_PORT=8080

JPA_SHOW_SQL=true
JPA_DDL_AUTO=validate
HIBERNATE_FORMAT_SQL=true
HIBERNATE_JDBC_BATCH_SIZE=25

# Development only. The production profile requires an explicitly configured secret.
ACCESS_CODE_HASH_SECRET=dev-only-change-me
ACCESS_CODE_LENGTH=8

RESERVATION_EXPIRATION_ENABLED=true
RESERVATION_EXPIRATION_FIXED_DELAY_MS=60000
RESERVATION_EXPIRATION_BATCH_SIZE=50
