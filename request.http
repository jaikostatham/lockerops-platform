###############################################################
# LOCKEROPS PLATFORM - HTTP REQUESTS
#
# Backend:
# http://localhost:8080
#
# Endpoint:
# /api/locker-stations
#
# Nota:
# - Ejecuta primero DEMO 02.
# - Copia el "id" devuelto por el POST.
# - Pega ese valor en @demoLockerStationId.
###############################################################

@baseUrl = http://localhost:8080
@demoLockerStationId = 5
@notFoundId = 999999

###############################################################
# HAPPY PATH - CRUD FLOW
###############################################################

### DEMO 01 - Get All Locker Stations

GET {{baseUrl}}/api/locker-stations


### DEMO 02 - Create Locker Station

POST {{baseUrl}}/api/locker-stations
Content-Type: application/json

{
  "name": "Locker Station Madrid Centro",
  "model": "LOCKER PRO",
  "manufacturer": "FINOCIO",
  "status": "ACTIVE",
  "location": "Madrid Centro",
  "imageUrl": "https://example.com/locker-madrid.jpg"
}


### DEMO 03 - Get Locker Station By Id
# Cambia @demoLockerStationId por el id devuelto en DEMO 02.

GET {{baseUrl}}/api/locker-stations/{{demoLockerStationId}}


### DEMO 04 - Update Locker Station

PUT {{baseUrl}}/api/locker-stations/{{demoLockerStationId}}
Content-Type: application/json

{
  "name": "Locker Station Madrid Centro Updated",
  "model": "LOCKER PRO V2",
  "manufacturer": "FINOCIO",
  "status": "MAINTENANCE",
  "location": "Madrid Centro",
  "imageUrl": "https://example.com/locker-madrid-updated.jpg"
}


### DEMO 05 - Verify Update

GET {{baseUrl}}/api/locker-stations/{{demoLockerStationId}}


### DEMO 06 - Delete Locker Station

DELETE {{baseUrl}}/api/locker-stations/{{demoLockerStationId}}


### DEMO 07 - Verify Delete

GET {{baseUrl}}/api/locker-stations/{{demoLockerStationId}}


### DEMO 08 - Get All Locker Stations Final State

GET {{baseUrl}}/api/locker-stations


###############################################################
# ERROR CASES - VALIDATION AND EXCEPTION HANDLING
###############################################################

### ERROR 01 - Create Locker Station With Validation Errors

POST {{baseUrl}}/api/locker-stations
Content-Type: application/json

{
  "name": "",
  "model": "",
  "manufacturer": "",
  "status": null,
  "location": "",
  "imageUrl": "https://example.com/locker.jpg"
}


### ERROR 02 - Create Locker Station With Invalid Enum

POST {{baseUrl}}/api/locker-stations
Content-Type: application/json

{
  "name": "Locker Station Invalid Enum",
  "model": "LOCKER PRO",
  "manufacturer": "FINOCIO",
  "status": "BROKEN",
  "location": "Madrid Centro",
  "imageUrl": "https://example.com/locker-invalid-enum.jpg"
}


### ERROR 03 - Get Locker Station Not Found

GET {{baseUrl}}/api/locker-stations/{{notFoundId}}


### ERROR 04 - Update Locker Station Not Found

PUT {{baseUrl}}/api/locker-stations/{{notFoundId}}
Content-Type: application/json

{
  "name": "Locker Station Not Found",
  "model": "LOCKER PRO",
  "manufacturer": "FINOCIO",
  "status": "ACTIVE",
  "location": "Madrid Centro",
  "imageUrl": "https://example.com/locker-not-found.jpg"
}


### ERROR 05 - Delete Locker Station Not Found

DELETE {{baseUrl}}/api/locker-stations/{{notFoundId}}