###############################################################
# LOCKEROPS PLATFORM - HTTP REQUESTS
#
# Backend:
# http://localhost:8080
#
# Notes:
# - Update the variables below with the ids returned by the API.
# - @demoLockerStationId is used for LockerStation CRUD tests.
# - @compartmentLockerStationId is used for LockerCompartment tests.
# - @demoLockerCompartmentId is used for LockerCompartment CRUD tests.
# - @reservationLockerCompartmentId is used for Reservation tests.
# - It must point to an AVAILABLE locker compartment before creating a reservation.
# - After creating a reservation, copy the returned "id" into @demoReservationId.

###############################################################

@baseUrl = http://localhost:8080
@demoLockerStationId = 5
@compartmentLockerStationId = 1
@demoLockerCompartmentId = 1
@notFoundId = 999999
@demoReservationId = 1
@reservationLockerCompartmentId = 2
@reservationCustomerReference = KIOSK-SESSION-001

###############################################################
# LOCKER STATIONS - HAPPY PATH CRUD FLOW
###############################################################

### STATION DEMO 01 - Get All Locker Stations

GET {{baseUrl}}/api/locker-stations


### STATION DEMO 02 - Create Locker Station
# Copy the returned "id" into @demoLockerStationId if you want to use it below.

POST {{baseUrl}}/api/locker-stations
Content-Type: application/json

{
  "name": "Locker Station Madrid Centro",
  "model": "LOCKER PRO",
  "manufacturer": "FINOCIO",
  "status": "ACTIVE",
  "location": "Madrid Centro",
  "imageUrl": "https://example.com/locker-madrid.jpg"
}


### STATION DEMO 03 - Get Locker Station By Id

GET {{baseUrl}}/api/locker-stations/{{demoLockerStationId}}


### STATION DEMO 04 - Update Locker Station

PUT {{baseUrl}}/api/locker-stations/{{demoLockerStationId}}
Content-Type: application/json

{
  "name": "Locker Station Madrid Centro Updated",
  "model": "LOCKER PRO V2",
  "manufacturer": "FINOCIO",
  "status": "MAINTENANCE",
  "location": "Madrid Centro",
  "imageUrl": "https://example.com/locker-madrid-updated.jpg"
}


### STATION DEMO 05 - Verify Locker Station Update

GET {{baseUrl}}/api/locker-stations/{{demoLockerStationId}}


### STATION DEMO 06 - Delete Locker Station
# Execute this only if the station has no compartments associated.

DELETE {{baseUrl}}/api/locker-stations/{{demoLockerStationId}}


### STATION DEMO 07 - Verify Deleted Locker Station

GET {{baseUrl}}/api/locker-stations/{{demoLockerStationId}}


### STATION DEMO 08 - Get All Locker Stations Final State

GET {{baseUrl}}/api/locker-stations


###############################################################
# LOCKER STATIONS - ERROR CASES
###############################################################

### STATION ERROR 01 - Create Locker Station With Validation Errors

POST {{baseUrl}}/api/locker-stations
Content-Type: application/json

{
  "name": "",
  "model": "",
  "manufacturer": "",
  "status": null,
  "location": "",
  "imageUrl": "https://example.com/locker.jpg"
}


### STATION ERROR 02 - Create Locker Station With Invalid Enum

POST {{baseUrl}}/api/locker-stations
Content-Type: application/json

{
  "name": "Locker Station Invalid Enum",
  "model": "LOCKER PRO",
  "manufacturer": "FINOCIO",
  "status": "BROKEN",
  "location": "Madrid Centro",
  "imageUrl": "https://example.com/locker-invalid-enum.jpg"
}


### STATION ERROR 03 - Get Locker Station Not Found

GET {{baseUrl}}/api/locker-stations/{{notFoundId}}


### STATION ERROR 04 - Update Locker Station Not Found

PUT {{baseUrl}}/api/locker-stations/{{notFoundId}}
Content-Type: application/json

{
  "name": "Locker Station Not Found",
  "model": "LOCKER PRO",
  "manufacturer": "FINOCIO",
  "status": "ACTIVE",
  "location": "Madrid Centro",
  "imageUrl": "https://example.com/locker-not-found.jpg"
}


### STATION ERROR 05 - Delete Locker Station Not Found

DELETE {{baseUrl}}/api/locker-stations/{{notFoundId}}


###############################################################
# LOCKER COMPARTMENTS - HAPPY PATH CRUD FLOW
#
# Notes:
# - Use an existing LockerStation.
# - Copy its id into @compartmentLockerStationId.
# - After creating a compartment, copy the returned "id" into
#   @demoLockerCompartmentId.
###############################################################

### COMPARTMENT DEMO 01 - Create Locker Compartment

POST {{baseUrl}}/api/locker-stations/{{compartmentLockerStationId}}/compartments
Content-Type: application/json

{
  "compartmentNumber": 1,
  "size": "MEDIUM",
  "status": "AVAILABLE"
}


### COMPARTMENT DEMO 02 - Get Locker Compartments By Station Id

GET {{baseUrl}}/api/locker-stations/{{compartmentLockerStationId}}/compartments


### COMPARTMENT DEMO 03 - Get Locker Compartment By Id

GET {{baseUrl}}/api/locker-compartments/{{demoLockerCompartmentId}}


### COMPARTMENT DEMO 04 - Update Locker Compartment

PUT {{baseUrl}}/api/locker-compartments/{{demoLockerCompartmentId}}
Content-Type: application/json

{
  "compartmentNumber": 2,
  "size": "LARGE",
  "status": "OUT_OF_SERVICE"
}


### COMPARTMENT DEMO 05 - Verify Locker Compartment Update

GET {{baseUrl}}/api/locker-compartments/{{demoLockerCompartmentId}}


### COMPARTMENT DEMO 06 - Create Another Locker Compartment In Same Station

POST {{baseUrl}}/api/locker-stations/{{compartmentLockerStationId}}/compartments
Content-Type: application/json

{
  "compartmentNumber": 3,
  "size": "SMALL",
  "status": "AVAILABLE"
}


### COMPARTMENT DEMO 07 - Get Locker Compartments By Station Id Final State

GET {{baseUrl}}/api/locker-stations/{{compartmentLockerStationId}}/compartments


### COMPARTMENT DEMO 08 - Delete Locker Compartment

DELETE {{baseUrl}}/api/locker-compartments/{{demoLockerCompartmentId}}


### COMPARTMENT DEMO 09 - Verify Deleted Locker Compartment

GET {{baseUrl}}/api/locker-compartments/{{demoLockerCompartmentId}}


###############################################################
# LOCKER COMPARTMENTS - ERROR CASES
###############################################################

### COMPARTMENT ERROR 01 - Create Duplicate Locker Compartment In Same Station
# This expects that compartmentNumber 2 already exists in @compartmentLockerStationId.
# Run COMPARTMENT DEMO 04 first if needed.

POST {{baseUrl}}/api/locker-stations/{{compartmentLockerStationId}}/compartments
Content-Type: application/json

{
  "compartmentNumber": 2,
  "size": "SMALL",
  "status": "AVAILABLE"
}


### COMPARTMENT ERROR 02 - Create Locker Compartment In Non Existing Station

POST {{baseUrl}}/api/locker-stations/{{notFoundId}}/compartments
Content-Type: application/json

{
  "compartmentNumber": 1,
  "size": "MEDIUM",
  "status": "AVAILABLE"
}


### COMPARTMENT ERROR 03 - Create Locker Compartment With Validation Errors

POST {{baseUrl}}/api/locker-stations/{{compartmentLockerStationId}}/compartments
Content-Type: application/json

{
  "compartmentNumber": 0,
  "size": "MEDIUM",
  "status": "AVAILABLE"
}


### COMPARTMENT ERROR 04 - Create Locker Compartment With Invalid Size Enum

POST {{baseUrl}}/api/locker-stations/{{compartmentLockerStationId}}/compartments
Content-Type: application/json

{
  "compartmentNumber": 4,
  "size": "BIG",
  "status": "AVAILABLE"
}


### COMPARTMENT ERROR 05 - Create Locker Compartment With Invalid Status Enum

POST {{baseUrl}}/api/locker-stations/{{compartmentLockerStationId}}/compartments
Content-Type: application/json

{
  "compartmentNumber": 4,
  "size": "MEDIUM",
  "status": "BLOCKED"
}


### COMPARTMENT ERROR 06 - Get Locker Compartment Not Found

GET {{baseUrl}}/api/locker-compartments/{{notFoundId}}


### COMPARTMENT ERROR 07 - Update Locker Compartment Not Found

PUT {{baseUrl}}/api/locker-compartments/{{notFoundId}}
Content-Type: application/json

{
  "compartmentNumber": 1,
  "size": "MEDIUM",
  "status": "AVAILABLE"
}


### COMPARTMENT ERROR 08 - Delete Locker Compartment Not Found

DELETE {{baseUrl}}/api/locker-compartments/{{notFoundId}}



###############################################################
# RESERVATIONS - HAPPY PATH FLOW
#
# Notes:
# - Use an existing AVAILABLE LockerCompartment.
# - Copy its id into @reservationLockerCompartmentId.
# - After creating a reservation, copy the returned "id" into
# @demoReservationId.
# - Creating a reservation changes the LockerCompartment status
# from AVAILABLE to RESERVED.
# - Cancelling a reservation changes the LockerCompartment status
# from RESERVED back to AVAILABLE.
###############################################################

-

### RESERVATION DEMO 01 - Check Locker Compartments By Station Id
# Use this request to find an AVAILABLE compartment.

GET {{baseUrl}}/api/locker-stations/{{compartmentLockerStationId}}/compartments

### RESERVATION DEMO 02 - Get Locker Compartment Before Reservation
# Expected status before creating reservation: AVAILABLE.

GET {{baseUrl}}/api/locker-compartments/{{reservationLockerCompartmentId}}

### RESERVATION DEMO 03 - Create Reservation
# Copy the returned "id" into @demoReservationId.

POST {{baseUrl}}/api/reservations
Content-Type: application/json

{
  "lockerCompartmentId": {{reservationLockerCompartmentId}},
  "durationMinutes": 120,
  "customerReference": "{{reservationCustomerReference}}"
}

### RESERVATION DEMO 04 - Get All Reservations

GET {{baseUrl}}/api/reservations

### RESERVATION DEMO 05 - Get Reservation By Id

GET {{baseUrl}}/api/reservations/{{demoReservationId}}

### RESERVATION DEMO 06 - Verify Locker Compartment Is Reserved
# Expected status after creating reservation: RESERVED.

GET {{baseUrl}}/api/locker-compartments/{{reservationLockerCompartmentId}}

### RESERVATION DEMO 07 - Cancel Reservation

PATCH {{baseUrl}}/api/reservations/{{demoReservationId}}/cancel

### RESERVATION DEMO 08 - Verify Reservation Was Cancelled
# Expected reservation status: CANCELLED.

GET {{baseUrl}}/api/reservations/{{demoReservationId}}

### RESERVATION DEMO 09 - Verify Locker Compartment Is Available Again
# Expected status after cancelling reservation: AVAILABLE.

GET {{baseUrl}}/api/locker-compartments/{{reservationLockerCompartmentId}}

###############################################################
# RESERVATIONS - ERROR CASES
###############################################################

### RESERVATION ERROR 01 - Create Reservation With Validation Errors
# Expected: 400 Bad Request.

POST {{baseUrl}}/api/reservations
Content-Type: application/json

{
  "lockerCompartmentId": null,
  "durationMinutes": 0,
  "customerReference": "INVALID-RESERVATION"
}

### RESERVATION ERROR 02 - Create Reservation With Non Existing Locker Compartment
# Expected: 404 Not Found.

POST {{baseUrl}}/api/reservations
Content-Type: application/json

{
  "lockerCompartmentId": {{notFoundId}},
  "durationMinutes": 120,
  "customerReference": "KIOSK-SESSION-NOT-FOUND"
}

### RESERVATION ERROR 03 - Create Reservation For Unavailable Locker Compartment
# Expected: 409 Conflict.
# Run RESERVATION DEMO 03 first and execute this before cancelling the reservation.

POST {{baseUrl}}/api/reservations
Content-Type: application/json

{
  "lockerCompartmentId": {{reservationLockerCompartmentId}},
  "durationMinutes": 120,
  "customerReference": "KIOSK-SESSION-DUPLICATE"
}

### RESERVATION ERROR 04 - Get Reservation Not Found
# Expected: 404 Not Found.

GET {{baseUrl}}/api/reservations/{{notFoundId}}

### RESERVATION ERROR 05 - Cancel Reservation Not Found
# Expected: 404 Not Found.

PATCH {{baseUrl}}/api/reservations/{{notFoundId}}/cancel

### RESERVATION ERROR 06 - Cancel Reservation Already Cancelled
# Expected: 409 Conflict.
# Run RESERVATION DEMO 07 first, then execute this request again.

PATCH {{baseUrl}}/api/reservations/{{demoReservationId}}/cancel

### RESERVATION ERROR 07 - Create Reservation With Invalid JSON Type
# Expected: 400 Bad Request.

POST {{baseUrl}}/api/reservations
Content-Type: application/json

{
  "lockerCompartmentId": "invalid-id",
  "durationMinutes": 120,
  "customerReference": "KIOSK-SESSION-INVALID-TYPE"
}
